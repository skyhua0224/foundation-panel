{
  "name": "sunshine-gui",
  "version": "0.0.0-dev",
  "description": "A GUI for sunshine",
  "license": "MIT",
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-native-plugins.ps1 -Configuration Debug && tauri dev",
    "dev-webui": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-native-plugins.ps1 -Configuration Debug && cross-env WEBUI_DEV_TARGET=https://localhost:3000 tauri dev",
    "dev:toolbar": "npm run build:renderer && cargo build --manifest-path src-tauri/Cargo.toml && src-tauri\\target\\debug\\sunshine-gui.exe --toolbar",
    "dev:renderer": "vite --config vite.config.js",
    "test:renderer": "node --import foundation-ui/testing/no-network --test",
    "build": "npm run build:native-plugins && tauri build",
    "build:renderer": "vite build --config vite.config.js",
    "build:native-plugins": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-native-plugins.ps1",
    "build:home": "vite build --config vite.home.config.js --mode production",
    "dev:home": "vite --config vite.home.config.js --mode development",
    "preview:home": "vite preview --config vite.home.config.js",
    "build:win": "npm run build:component:win",
    "build:component:win": "powershell -ExecutionPolicy Bypass -File ./scripts/build-gui-component-installer.ps1",
    "build:beta": "npm run build:native-plugins && cross-env BETA=true npm run build:renderer && tauri build --features beta",
    "build:beta:win": "cross-env BETA=true powershell -ExecutionPolicy Bypass -File ./scripts/build-gui-component-installer.ps1 -Beta",
    "build:installer-pages": "vite build --config vite.installer.config.js",
    "build:installer-ui": "npm run build:installer-pages && cargo build --release --manifest-path installer-ui/Cargo.toml"
  },
  "repository": "https://github.com/qiin2333/sunshine",
  "author": {
    "name": "qiin2333",
    "url": "https://github.com/qiin2333"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.1",
    "less": "^4.6.7",
    "vite": "^8.1.0"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.2.7",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "dompurify": "^3.4.16",
    "foundation-ui": "https://codeload.github.com/AlkaidLab/foundation-ui/tar.gz/9c8109897ec0137e5a1ce671f794c8913fb02f0e",
    "markdown-it": "^14.3.2",
    "pixi.js": "^8.19.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.38"
  },
  "engines": {
    "node": "24.22.3",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1"
}
