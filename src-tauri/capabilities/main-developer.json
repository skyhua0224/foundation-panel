{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-developer",
  "description": "Allows only the bundled main Control Panel window to use the tools of the developer page.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-dev-get-state",
    "allow-dev-set-cover-mode",
    "allow-dev-set-cold-cloak",
    "allow-dev-simulate-dpi",
    "allow-dev-open-devtools",
    "allow-dev-capture-window",
    "allow-dev-clear-webview-cache",
    "allow-dev-reset-desktop-settings",
    "allow-dev-environment"
  ]
}
